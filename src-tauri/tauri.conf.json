{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NightWorkers",
  "version": "0.1.0",
  "identifier": "dev.nightworkers.desktop",
  "build": {
    "beforeDevCommand": "bun run build:frontend && bun run desktop:prepare-sidecar && bun run dev:web:desktop",
    "beforeBuildCommand": "bun run build:frontend && bun run desktop:prepare-sidecar",
    "devUrl": "http://127.0.0.1:39174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NightWorkers",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 15
        },
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../api/services/supervisor/skills",
      "../api/services/procedures/builtin",
      "../scripts/desktop/staged"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
