{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NightWorkers",
  "version": "0.1.0",
  "identifier": "dev.nightworkers.desktop",
  "build": {
    "beforeDevCommand": "bun run build:frontend && bun run desktop:prepare-sidecar && bun run dev:web:desktop",
    "beforeBuildCommand": "bun run build:frontend && bun run desktop:prepare-sidecar",
    "devUrl": "http://127.0.0.1:39174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NightWorkers",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 15
        },
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://127.0.0.1:39173 ws://127.0.0.1:39173 http://tauri.localhost https://tauri.localhost; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../api/services/supervisor/skills",
      "../scripts/desktop/staged"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzMjlDNThDOTA3NEVEQjYKUldTMjdYU1FqTVVwOHcwa3VQNGJ3c0g2UEd0eUFGSno0N1BJbCtLdGhTTEtSbEZHMzJPVythT1UK",
      "endpoints": [
        "https://github.com/ugnoguchigxp/nightWorkers/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
