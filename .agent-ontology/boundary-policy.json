{
  "version": 1,
  "enforcedPublicApiRoots": [
    "api/modules/quality",
	"api/modules/blueprint",
	"src/modules/blueprint-preview",
	"api/modules/settings",
    "api/modules/llm-gateway",
	"src/modules/settings",
    "src/modules/quality",
    "api/modules/codingAgent",
    "api/modules/agentsShare",
    "src/modules/codingAgent",
    "src/modules/agentsShare",
    "shared/modules/codingAgent",
    "shared/modules/agentsShare",
		"shared/modules/taskOperator",
		"api/modules/taskOperator",
		"src/modules/taskOperator"
  ],
	"roleModuleRoots": [
    "api/modules/codingAgent",
    "src/modules/codingAgent",
    "shared/modules/codingAgent",
    "api/modules/missionPilot"
	],
	"agentSharedModuleRoots": [
	    "api/modules/agentsShare",
	    "src/modules/agentsShare",
	    "shared/modules/agentsShare"
	],
	"agentIndependentModuleRoots": [
	    "api/modules/planMode",
	    "src/modules/planMode"
	],
	"deepImportExemptions": [
		{
			"source": "api/db/bootstrap.ts",
			"specifier": "../modules/codingAgent/persistence/runtime-execution-bootstrap"
		},
		{
			"source": "api/db/client.ts",
			"specifier": "../modules/codingAgent/persistence/runtime-execution-schema"
		},
		{
			"source": "api/app.ts",
			"specifier": "./modules/codingAgent/mcp/nightworkers-codex-mcp"
		},
		{
			"source": "api/services/supervisor/prompt-tool-registry.ts",
			"specifier": "../../modules/codingAgent/mcp/nightworkers-tool-manifest"
		}
	],
	"roleOwnedPathRules": [
		{
			"role": "Mission Pilot",
			"markers": ["mission-pilot", "missionPilot"],
      "allowedRoots": [
        "packages/mission-pilot",
        "api/modules/missionPilot"
			],
			"exemptPrefixes": [
				"api/db/",
				"api/composition/mission-pilot/",
				"src/composition/mission-pilot/",
				"api/systemContexts/"
			]
		},
		{
			"role": "Coding Agent",
			"markers": ["coding-agent", "codingAgent"],
			"allowedRoots": [
				"api/modules/codingAgent",
				"src/modules/codingAgent",
				"shared/modules/codingAgent"
			],
			"exemptPrefixes": [
				"api/modules/agentsShare/contracts/coding-agent-run.ts",
				"api/modules/agentsShare/ports/coding-agent-run.ts"
			]
		}
	],
	"forbiddenProductionPathPrefixes": [
		"api/services/agent-runtime",
		"api/mcp/nightworkers-"
	],
  "domainForbiddenImports": [
    "react",
    "react-dom",
    "hono",
    "drizzle-orm",
    "@libsql/client",
    "openai",
    "@aws-sdk/client-bedrock-runtime"
  ]
}
