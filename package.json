{
  "name": "nightworkers",
  "version": "0.1.0",
  "description": "Local-first autonomous development control plane with native supervisor-worker runtime and contextStill.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --exclude './src/**' --exclude './shared/**' --exclude './tests/**' --exclude './*.ts' --exclude './*.tsx' --exclude './*.js' --exclude './*.json' --exclude './*.md' api/index.ts",
    "dev:web": "vite",
    "prepare": "husky",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:frontend": "vite build",
    "build:backend": "esbuild api/index.ts --bundle --packages=external --platform=node --target=node20 --format=esm --outfile=dist-api/index.js",
    "build:backend:desktop": "node scripts/desktop/build-backend.mjs",
    "start": "cross-env NODE_ENV=production node dist-api/index.js",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:dmg": "tauri build --bundles dmg",
    "desktop:lint": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "desktop:prepare-sidecar": "pnpm build:backend:desktop && node scripts/desktop/prepare-sidecar.mjs",
    "desktop:smoke-sidecar": "node scripts/desktop/smoke-sidecar.mjs",
    "desktop:smoke": "node scripts/desktop/smoke-packaged-app.mjs",
    "desktop:sign": "node scripts/release/desktop-sign-notarize.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:supervisor-regression": "vitest run tests/supervisor/services-supervisor-01-part01.test.ts tests/supervisor/services-supervisor-01-part02.test.ts tests/supervisor/services-supervisor-02.test.ts tests/services.supervisor-skills.test.ts tests/supervisor-llm-provider/services-supervisor-llm-provider-01.test.ts tests/supervisor-llm-provider/services-supervisor-llm-provider-02.test.ts tests/supervisor-llm-provider/services-supervisor-llm-provider-03.test.ts",
    "test:desktop-runtime": "vitest run tests/runtime-paths.test.ts tests/runtime-bootstrap.test.ts tests/api-base.test.ts tests/preflight.test.ts tests/routes.security-hardening.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:all": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx drizzle/seed.ts",
    "cleanup:test-data": "tsx api/scripts/cleanup-test-data.ts --execute",
    "cleanup:test-data:dry-run": "tsx api/scripts/cleanup-test-data.ts --dry-run",
    "cleanup:test-data:all": "tsx api/scripts/cleanup-test-data.ts --all --execute",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:regression": "playwright test --grep @regression",
    "test:e2e:agent-outcome": "playwright test tests/e2e/nightworkers-agent.spec.ts",
    "test:e2e:agent-live": "playwright test --grep @agent-live",
    "format": "biome format --write .",
    "verify:base": "node scripts/verify.mjs base",
    "verify:desktop": "node scripts/verify.mjs desktop",
    "verify": "node scripts/verify.mjs verify",
    "verify:fast": "pnpm verify:base",
    "verify:full": "node scripts/verify.mjs full"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1057.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@hono/node-server": "^1.19.12",
    "@hono/node-ws": "^1.3.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.2.4",
    "@hono/zod-validator": "^0.7.6",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.135.0",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.0",
    "@types/ws": "^8.18.1",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.9",
    "i18next": "^26.3.1",
    "jose": "^6.2.2",
    "jsonrepair": "^3.14.0",
    "lucide-react": "^1.7.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.2",
    "shadcn": "^4.1.2",
    "smol-toml": "^1.6.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@hono/vite-dev-server": "^0.25.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/router-plugin": "^1.167.12",
    "@tauri-apps/cli": "^2.11.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.5",
    "husky": "^9.1.7",
    "msw": "^2.12.14",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
