{
	"name": "nightworkers",
	"version": "0.1.0",
	"description": "Local-first autonomous development control plane with native supervisor-worker runtime and contextStill.",
	"main": "index.js",
	"scripts": {
		"setup": "bun install && (test -f .env || cp .env.example .env) && bun run db:migrate && bun run db:seed",
		"dev": "concurrently -k -n api,web -c cyan,magenta \"bun run dev:api\" \"bun run dev:web\"",
		"dev:api": "bun api/index.ts",
		"dev:web": "vite",
		"dev:web:desktop": "cross-env NIGHTWORKERS_DESKTOP_DEV=1 VITE_NIGHTWORKERS_DESKTOP=1 vite --host 127.0.0.1",
		"prepare": "husky",
		"build": "bun run build:frontend && bun run build:backend",
		"build:frontend": "vite build",
		"build:backend": "esbuild api/index.ts --bundle --packages=external --platform=node --target=node20 --format=esm --outfile=dist-api/index.js",
		"build:backend:desktop": "node scripts/desktop/build-backend.mjs",
		"start": "cross-env NODE_ENV=production bun dist-api/index.js",
		"tauri": "tauri",
		"desktop:dev": "tauri dev --no-watch",
		"desktop:build": "tauri build",
		"desktop:build:dmg": "tauri build --bundles dmg",
		"desktop:build:linux": "tauri build --bundles deb,rpm,appimage",
		"desktop:build:windows": "tauri build --bundles nsis,msi",
		"desktop:check:cross-platform": "node scripts/desktop/check-cross-platform-readiness.mjs",
		"desktop:lint": "bun run desktop:check:cross-platform && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
		"desktop:prepare-sidecar": "bun run build:backend:desktop && node scripts/desktop/prepare-sidecar.mjs",
		"desktop:smoke-sidecar": "node scripts/desktop/smoke-sidecar.mjs",
		"desktop:smoke": "node scripts/desktop/smoke-packaged-app.mjs",
		"desktop:sign": "node scripts/release/desktop-sign-notarize.mjs",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:coverage:backend": "vitest run --config vitest.backend.config.ts --coverage",
		"test:coverage:frontend": "vitest run --config vitest.frontend.config.ts --coverage",
		"test:live:llm": "vitest run --config vitest.live.config.ts",
		"test:supervisor-regression": "vitest run tests/services.supervisor-skills.test.ts tests/services.supervisor-prompt-packet.test.ts tests/structured-llm/services-structured-llm-01.test.ts tests/structured-llm/services-structured-llm-02.test.ts tests/structured-llm/services-structured-llm-03.test.ts",
		"test:desktop-runtime": "vitest run tests/runtime-paths.test.ts tests/runtime-bootstrap.test.ts tests/api-base.test.ts tests/preflight.test.ts tests/routes.security-hardening.test.ts",
		"check:tracked-artifacts": "bun scripts/check-tracked-artifacts.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:all": "biome check .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:push": "drizzle-kit push",
		"db:seed": "bun drizzle/seed.ts",
		"db:dump:current": "bun api/scripts/dump-current-state.ts",
		"db:seed:current": "bun api/scripts/seed-current-state.ts",
		"db:reset": "bun api/scripts/reset-db.ts",
		"db:init": "bun run db:reset && bun run db:seed:current",
		"db:init:empty": "bun run db:reset && bun run db:seed",
		"llm-usage:backfill-summary": "bun api/scripts/backfill-llm-usage-summary.ts",
		"llm-usage:check-summary": "bun api/scripts/check-llm-usage-summary-integrity.ts",
		"cleanup:test-data": "bun api/scripts/cleanup-test-data.ts --execute",
		"cleanup:test-data:dry-run": "bun api/scripts/cleanup-test-data.ts --dry-run",
		"cleanup:test-data:all": "bun api/scripts/cleanup-test-data.ts --all --execute",
		"codex:mcp:remove": "node scripts/setup-codex-nightworkers-mcp.mjs --remove",
		"test:e2e": "playwright test",
		"test:e2e:smoke": "playwright test --grep @smoke",
		"test:e2e:regression": "playwright test --grep @regression",
		"test:e2e:agent-outcome": "playwright test tests/e2e/nightworkers-agent.spec.ts",
		"test:e2e:agent-live": "playwright test tests/e2e/nightworkers-agent.spec.ts --grep @agent-live",
		"format": "biome format --write .",
		"verify:base": "bun scripts/verify.mjs base",
		"verify:desktop": "bun scripts/verify.mjs desktop",
		"verify": "bun scripts/verify.mjs verify",
		"verify:fast": "bun run verify:base",
		"verify:full": "bun scripts/verify.mjs full",
		"verify:live": "bun run verify && bun run test:live:llm && bun run test:e2e:agent-live"
	},
	"type": "module",
	"keywords": [],
	"author": "",
	"license": "MIT",
	"packageManager": "bun@1.3.14",
	"dependencies": {
		"@aws-sdk/client-bedrock-runtime": "3.1057.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@fontsource-variable/geist": "5.2.8",
		"@hono/node-server": "1.19.13",
		"@hono/node-ws": "1.3.1",
		"@hono/swagger-ui": "0.6.1",
		"@hono/zod-openapi": "1.2.4",
		"@hono/zod-validator": "0.7.6",
		"@libsql/client": "0.17.3",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@openai/codex-sdk": "0.135.0",
		"@tanstack/react-query": "5.96.1",
		"@tanstack/react-router": "1.168.10",
		"@tanstack/react-table": "8.21.3",
		"@tauri-apps/api": "2.11.0",
		"@types/ws": "8.18.1",
		"argon2": "0.44.0",
		"better-sqlite3": "12.10.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"dotenv": "17.4.0",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.21",
		"i18next": "26.3.1",
		"jose": "6.2.2",
		"jsonrepair": "3.14.0",
		"lucide-react": "1.7.0",
		"mermaid": "^11.16.0",
		"pino": "10.3.1",
		"radix-ui": "1.4.3",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-i18next": "17.0.8",
		"react-markdown": "10.1.0",
		"react-resizable-panels": "4.11.2",
		"recharts": "3.8.1",
		"remark-gfm": "4.0.1",
		"sanitize-html": "2.17.3",
		"shadcn": "4.1.2",
		"smol-toml": "1.6.1",
		"tailwind-merge": "3.5.0",
		"tw-animate-css": "1.4.0",
		"ws": "8.21.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@hono/vite-dev-server": "0.25.1",
		"@playwright/test": "1.59.1",
		"@tailwindcss/cli": "4.2.4",
		"@tailwindcss/vite": "4.2.4",
		"@tanstack/router-plugin": "1.167.12",
		"@tauri-apps/cli": "2.11.2",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "25.5.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/sanitize-html": "2.16.1",
		"@vitejs/plugin-react": "4.7.0",
		"@vitest/coverage-v8": "4.1.2",
		"autoprefixer": "10.4.27",
		"concurrently": "9.2.1",
		"cross-env": "10.1.0",
		"drizzle-kit": "0.31.10",
		"esbuild": "0.28.1",
		"husky": "9.1.7",
		"msw": "2.12.14",
		"pino-pretty": "13.1.3",
		"postcss": "8.5.10",
		"tailwindcss": "4.0.0",
		"tailwindcss-animate": "1.0.7",
		"typescript": "6.0.2",
		"vite": "6.4.2",
		"vitest": "4.1.2"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"overrides": {
		"fast-uri": "3.1.2"
	}
}
