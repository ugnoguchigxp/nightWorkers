{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@/*": ["./src/*"],
			"@api/*": ["./api/*"],
			"@nightworkers/mission-pilot/backend": [
				"./packages/mission-pilot/src/backend/index.ts"
			],
			"@nightworkers/mission-pilot/contracts": [
				"./packages/mission-pilot/src/contracts/index.ts"
			],
			"@nightworkers/mission-pilot/frontend": [
				"./packages/mission-pilot/src/frontend/index.ts"
			],
			"@nightworkers/mission-pilot/i18n": [
				"./packages/mission-pilot/src/frontend/i18n/index.ts"
			],
			"@nightworkers/mission-pilot/testing": [
				"./packages/mission-pilot/src/testing/index.ts"
			],
			"@nightworkers/mission-pilot/frontend.css": [
				"./packages/mission-pilot/src/frontend/styles.css"
			]
		},
		"types": ["node", "vite/client"]
	},
	"include": [
		"src/**/*",
		"api/**/*",
		"shared/**/*",
		"packages/mission-pilot/src/**/*"
	],
	"exclude": ["node_modules", "dist", "drizzle"]
}
