# NightWorkers Environment Configuration

# Application
NODE_ENV=development
PORT=39173
APP_URL=http://localhost:39174
CORS_ORIGIN=http://localhost:39174
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
VITE_ENABLE_MSW=false
LOG_LEVEL=info
AUTH_MODE=both # local, oauth, or both

# Database (SQLite / LibSQL)
# ローカル開発では sqlite.db がデフォルトで使用されます
DATABASE_URL=sqlite.db

# Security (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Providers (AUTH_MODE が oauth または both の場合に必要に応じて設定)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Conversation Context StateCard (disabled by default)
CONVERSATION_CONTEXT_ENABLED=false
CONVERSATION_CONTEXT_STATE_CARD_ENABLED=false
CONVERSATION_CONTEXT_BUILD_ON_IDLE=false
CONVERSATION_CONTEXT_MAX_TOKENS=1200
CONVERSATION_CONTEXT_INCLUDE_SMALL_TARGET_FILE=true
CONVERSATION_CONTEXT_SMALL_FILE_CHAR_LIMIT=6000
