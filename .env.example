# NightWorkers Environment Configuration

# Application
NODE_ENV=development
VITE_ENABLE_MSW=false

# Desktop packaging
# Tauri sets these automatically for the packaged sidecar. Leave them unset in
# normal browser development unless you are debugging desktop runtime paths.
# NIGHTWORKERS_DESKTOP=1
# NIGHTWORKERS_RUNTIME_DIR=
# NIGHTWORKERS_RESOURCE_DIR=
# NIGHTWORKERS_API_ORIGIN=
# NIGHTWORKERS_FRONTEND_DIST=

# Database
# 通常開発では .nightworkers/sqlite.db、desktopではruntime data rootの
# sqlite.dbを自動使用します。DATABASE_URLの指定は不要です。
# NIGHTWORKERS_DATABASE_ACCESS_SCOPEは正規launcherが設定します。
# .envへ固定すると隔離テストを上書きするため、手動設定しないでください。

# Server、LLM provider、runtime設定はSettings画面から変更し、
# `.nightworkers/sqlite.db`へ保存します。NightWorkers自体のaccount／OAuth認証は
# 持たず、APIはloopback addressだけでlistenします。

# Conversation Context StateCard (enabled by default; set false to disable)
CONVERSATION_CONTEXT_ENABLED=true
CONVERSATION_CONTEXT_STATE_CARD_ENABLED=true
CONVERSATION_CONTEXT_BUILD_ON_IDLE=true
CONVERSATION_CONTEXT_MAX_TOKENS=1200
CONVERSATION_CONTEXT_INCLUDE_SMALL_TARGET_FILE=true
CONVERSATION_CONTEXT_SMALL_FILE_CHAR_LIMIT=6000
NIGHTWORKERS_SECURITY_INTELLIGENCE_CONSUMER_ENABLED=false
NIGHTWORKERS_SECURITY_INTELLIGENCE_PROJECT_ALLOWLIST=
NIGHTWORKERS_SECURITY_INTELLIGENCE_POST_ASSESSMENT_ENABLED=false
NIGHTWORKERS_SECURITY_KNOWLEDGE_CANDIDATE_EXPORT_ENABLED=false
NIGHTWORKERS_SECURITY_KNOWLEDGE_FEEDBACK_EXPORT_ENABLED=false
NIGHTWORKERS_CONTEXT_STILL_INTEGRATION_URL=http://127.0.0.1:39170
NIGHTWORKERS_CONTEXT_STILL_CANDIDATE_TOKEN=
NIGHTWORKERS_CONTEXT_STILL_FEEDBACK_TOKEN=
