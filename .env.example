# NightWorkers Environment Configuration

# Application
NODE_ENV=development
PORT=39173
APP_URL=http://localhost:39174
CORS_ORIGIN=http://localhost:39174
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
VITE_ENABLE_MSW=false
LOG_LEVEL=info
AUTH_MODE=both # local, oauth, or both

# Database (SQLite / LibSQL)
# ローカル開発では sqlite.db がデフォルトで使用されます
DATABASE_URL=sqlite.db

# Security (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# External Agent Integration (OpenHands / non-destructive sidecar mode)
# 隣接する ../OpenHands ディレクトリを汚染せず、外部プロセスとして起動するためのランナー設定です。
#
# オプション A: Poetry を用いた直接プロセス起動 (推奨)
# ../OpenHands の Poetry 仮想環境を利用して、ホスト側から直接 OpenHands のヘッドレスコマンドを実行します。
# -C ../OpenHands を渡すことで、カレントディレクトリを移動せず非破壊的に実行できます。
OPENHANDS_COMMAND=poetry
OPENHANDS_ARGS=-C ../OpenHands run python -m openhands.core.main -p "{prompt}" -d "{repoPath}"

# オプション B: Docker を用いたコンテナ起動
# ローカルの Docker ソケットを共有して ghcr.io の OpenHands 公式コンテナを立ち上げます。
# OPENHANDS_COMMAND=docker
# OPENHANDS_ARGS=run --rm -e SANDBOX_USER_ID=1000 -v /var/run/docker.sock:/var/run/docker.sock -v {repoPath}:/workspace ghcr.io/all-hands-ai/openhands:latest -p "{prompt}"

# OAuth Providers (AUTH_MODE が oauth または both の場合に必要に応じて設定)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
